# Copy this file to .env.local and fill in what you have.
# Anything left empty simply turns that feature off. The site still runs.

# The public address of the site, no trailing slash. Used in emails and the share link.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics. Leave empty to load no tracking at all.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_TAG_ID=

# Supabase (database). Find these in Supabase: Project Settings > API.
# The service role key is a SECRET. Never put it in a NEXT_PUBLIC_ variable.
# Project "family-guardian" already exists. The URL is not secret:
SUPABASE_URL=https://pfvdnefygpffmqfytnyx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (the optional $10 deposit). Use test keys (sk_test_...) while testing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (confirmation email). EMAIL_FROM must use a domain you verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=

# The one password that protects /admin. Pick a long one.
ADMIN_PASSWORD=

# Link for the "Book a 15-minute call" button on /confirmed.
CALENDAR_LINK=
